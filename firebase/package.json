{
  "name": "movie-streaming-firestore-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --project movie-streaming-rules-tests --config ../firebase.json --only firestore \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run",
    "test:functions:admin-lifecycle": "firebase emulators:exec --project movie-streaming-rules-tests --config ../firebase.json --only auth,firestore,functions \"node scripts/smoke-admin-auth-lifecycle.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.26.0",
    "vitest": "^3.2.4"
  }
}