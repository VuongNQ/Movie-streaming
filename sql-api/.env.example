PORT=4100

# Database Driver Selection
# Options: pg (PostgreSQL) or mysql (MySQL)
# Default: pg
DB_TYPE=pg

# Database Connection (applies to both PostgreSQL and MySQL)
DB_HOST=localhost
# Default ports: PostgreSQL=5432, MySQL=3306
# Adjust DB_PORT based on your DB_TYPE selection above
DB_PORT=5432
DB_NAME=movie_streaming
DB_USER=root
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h

# Admin Features
PASSWORD_RESET_LINK_BASE=http://localhost:5173/reset-password