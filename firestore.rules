rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function userRole() {
      return hasUserDoc() ? get(userDocPath()).data.role : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidMovieType(value) {
      return value in ['single_movie', 'tv_series', 'franchise'];
    }

    function isStringArray(value) {
      return value is list;
    }

    function isOptionalStringArrayField(data, fieldName) {
      return !(fieldName in data) || isStringArray(data[fieldName]);
    }

    function isValidStreamConnections(value) {
      return value is list;
    }

    function isValidMovieWrite(data) {
      return data.id is string && data.id.size() > 0 &&
        data.title_raw is string && data.title_raw.size() > 0 &&
        (!('title' in data) || (data.title is string && data.title == data.title_raw)) &&
        (!('title_vietnamese' in data) || data.title_vietnamese is string) &&
        isOptionalStringArrayField(data, 'title_search_keywords') &&
        isOptionalStringArrayField(data, 'title_vietnamese_search_keywords') &&
        data.description is string &&
        data.thumbnail_link is string &&
        data.background_link is string &&
        data.type is string && isValidMovieType(data.type) &&
        data.year is int &&
        data.episode_count is int && data.episode_count >= 1 &&
        isStringArray(data.actors) &&
        isStringArray(data.genres) &&
        data.audio_types is list &&
        data.audio_types.hasOnly(['dubbing', 'subtitle']) &&
        (!('franchise_movie_ids' in data) || data.franchise_movie_ids is list) &&
        isValidStreamConnections(data.stream_connections) &&
        (!('youtube_trailer_link' in data) || data.youtube_trailer_link is string);
    }

    function isMovieDocumentIdAligned(movieId, data) {
      return data.id is string && data.id == movieId;
    }

    function hasOnlyUserSafeFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['username']);
    }

    function isValidTrackingHistory(value) {
      return value is list;
    }

    function isOptionalStringField(data, fieldName) {
      return !(fieldName in data) || data[fieldName] is string;
    }

    function isOptionalMapField(data, fieldName) {
      return !(fieldName in data) || data[fieldName] is map;
    }

    function isValidReportType(value) {
      return value in ['broken_image', 'broken_stream'];
    }

    function isValidReportStatus(value) {
      return value in ['open', 'in_progress', 'resolved'];
    }

    function isValidReportIssueField(reportType, issueField) {
      return (reportType == 'broken_image' && issueField in ['thumbnail_link', 'background_link']) ||
        (reportType == 'broken_stream' && issueField == 'stream_link');
    }

    function hasOnlyReportCreateKeys(data) {
      return data.keys().hasOnly([
        'movie_id',
        'movie_title_raw',
        'report_type',
        'issue_field',
        'issue_link',
        'status',
        'reported_by_uid',
        'note',
        'preview_status',
        'preview_error_message',
        'preview_metadata',
        'created_at',
        'updated_at'
      ]);
    }

    function isValidReportCreate(data) {
      return hasOnlyReportCreateKeys(data) &&
        data.movie_id is string && data.movie_id.size() > 0 &&
        data.movie_title_raw is string && data.movie_title_raw.size() > 0 &&
        data.report_type is string && isValidReportType(data.report_type) &&
        data.issue_field is string && isValidReportIssueField(data.report_type, data.issue_field) &&
        data.issue_link is string && data.issue_link.size() > 0 &&
        data.status == 'open' &&
        data.reported_by_uid == request.auth.uid &&
        data.created_at is string &&
        data.updated_at is string &&
        isOptionalStringField(data, 'note') &&
        (!('preview_status' in data) || data.preview_status in ['live', 'dead']) &&
        isOptionalStringField(data, 'preview_error_message') &&
        isOptionalMapField(data, 'preview_metadata');
    }

    function isValidReportUpdate(data, previousData) {
      return data.movie_id == previousData.movie_id &&
        data.movie_title_raw == previousData.movie_title_raw &&
        data.report_type == previousData.report_type &&
        data.issue_field == previousData.issue_field &&
        data.issue_link == previousData.issue_link &&
        data.reported_by_uid == previousData.reported_by_uid &&
        data.created_at == previousData.created_at &&
        data.status is string && isValidReportStatus(data.status) &&
        data.updated_at is string &&
        isOptionalStringField(data, 'admin_note') &&
        (!('resolved_at' in data) || data.resolved_at is string) &&
        data.diff(previousData).changedKeys().hasOnly(['status', 'admin_note', 'updated_at', 'resolved_at']);
    }

    match /reports/{reportId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.reported_by_uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidReportCreate(request.resource.data);
      allow update: if isAdmin() && isValidReportUpdate(request.resource.data, resource.data);
      allow delete: if isAdmin();
    }

    match /movies/{movieId} {
      allow get, list: if true;
      allow create: if isAdmin() &&
        isMovieDocumentIdAligned(movieId, request.resource.data) &&
        isValidMovieWrite(request.resource.data);
      allow update: if isAdmin() &&
        isMovieDocumentIdAligned(movieId, request.resource.data) &&
        isValidMovieWrite(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['guest', 'user'] &&
        request.resource.data.created_at is string
      );

      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.created_at == resource.data.created_at &&
        hasOnlyUserSafeFields()
      );

      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow get, list: if isAdmin() || isOwner(uid);

        allow create, update: if isAdmin() || (
          isOwner(uid) &&
          request.resource.data.device_name is string &&
          isStringArray(request.resource.data.playlist) &&
          isValidTrackingHistory(request.resource.data.tracking_history)
        );

        allow delete: if isAdmin() || isOwner(uid);
      }
    }
  }
}
