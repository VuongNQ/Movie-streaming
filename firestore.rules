rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function userRole() {
      return hasUserDoc() ? get(userDocPath()).data.role : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidMovieType(value) {
      return value in ['single_movie', 'tv_series', 'franchise'];
    }

    function isStringArray(value) {
      return value is list;
    }

    function isValidStreamConnections(value) {
      return value is list;
    }

    function isValidMovieWrite(data) {
      return data.id is string && data.id.size() > 0 &&
        data.title is string && data.title.size() > 0 &&
        data.description is string &&
        data.thumbnail_link is string &&
        data.background_link is string &&
        data.type is string && isValidMovieType(data.type) &&
        data.year is int &&
        data.episode_count is int && data.episode_count >= 1 &&
        isStringArray(data.actors) &&
        isStringArray(data.genres) &&
        data.audio_types is list &&
        data.audio_types.hasOnly(['dubbing', 'subtitle']) &&
        isValidStreamConnections(data.stream_connections) &&
        (!('youtube_trailer_link' in data) || data.youtube_trailer_link is string);
    }

    function isMovieDocumentIdAligned(movieId, data) {
      return data.id is string && data.id == movieId;
    }

    function hasOnlyUserSafeFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['username']);
    }

    function isValidTrackingHistory(value) {
      return value is list;
    }

    match /movies/{movieId} {
      allow get, list: if true;
      allow create: if isAdmin() &&
        isMovieDocumentIdAligned(movieId, request.resource.data) &&
        isValidMovieWrite(request.resource.data);
      allow update: if isAdmin() &&
        isMovieDocumentIdAligned(movieId, request.resource.data) &&
        isValidMovieWrite(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['guest', 'user'] &&
        request.resource.data.created_at is string
      );

      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.created_at == resource.data.created_at &&
        hasOnlyUserSafeFields()
      );

      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow get, list: if isAdmin() || isOwner(uid);

        allow create, update: if isAdmin() || (
          isOwner(uid) &&
          request.resource.data.device_name is string &&
          isStringArray(request.resource.data.playlist) &&
          isValidTrackingHistory(request.resource.data.tracking_history)
        );

        allow delete: if isAdmin() || isOwner(uid);
      }
    }
  }
}
